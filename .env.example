# Toko Timbang Sepakat — Environment Configuration Template

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Path (defaults to ./data/tts.db)
DATABASE_PATH=./data/tts.db

# WhatsApp Business Order Dispatch (default placeholder, set before launching)
# Digunakan sebagai fallback jika belum diatur melalui admin settings
DEFAULT_WHATSAPP_NUMBER=6281234567890
