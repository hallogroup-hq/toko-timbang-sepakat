{
  "name": "toko-timbang-sepakat",
  "version": "1.0.0",
  "description": "B2B-first supplier storefront and back office for Toko Timbang Sepakat",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/api-entry.ts --bundle --platform=node --target=node22 --format=esm --external:node:sqlite --outfile=api/index.js && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:backup": "tsx server/scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
